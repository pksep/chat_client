<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/launch_background_light</item>
        <item name="android:background">@color/launch_background_light</item>
        <item name="windowSplashScreenBackground">@color/launch_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunchDark" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowBackground">@color/launch_background_dark</item>
        <item name="android:background">@color/launch_background_dark</item>
        <item name="windowSplashScreenBackground">@color/launch_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>

    <style name="AppTheme.StartupLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/launch_background_light</item>
        <item name="android:background">@color/launch_background_light</item>
        <item name="windowSplashScreenBackground">@color/launch_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/launch_background_light</item>
        <item name="android:navigationBarColor">@color/launch_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.StartupLaunchDark" parent="AppTheme.StartupLaunch">
        <item name="android:windowBackground">@color/launch_background_dark</item>
        <item name="android:background">@color/launch_background_dark</item>
        <item name="windowSplashScreenBackground">@color/launch_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
        <item name="android:statusBarColor">@color/launch_background_dark</item>
        <item name="android:navigationBarColor">@color/launch_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.PreparedMain" parent="AppTheme.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/launch_background_light</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/launch_background_light</item>
        <item name="android:navigationBarColor">@color/launch_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.PreparedMainDark" parent="AppTheme.PreparedMain">
        <item name="android:windowBackground">@color/launch_background_dark</item>
        <item name="android:statusBarColor">@color/launch_background_dark</item>
        <item name="android:navigationBarColor">@color/launch_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
