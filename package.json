{
  "name": "@pksep/chat-core",
  "version": "1.6.8",
  "type": "module",
  "main": "./build/lib/chat-container.js",
  "types": "./build/lib/chat-container.d.ts",
  "scripts": {
    "start:dev": "vite",
    "start": "vite preview",
    "lint": "vue-tsc && eslint --fix --ext .ts,.vue src",
    "build": "vue-tsc && vite build",
    "build:prod": "cross-env VITE_BASE_MODE=app vite build ",
    "test:e2e": "playwright test",
    "test:unit": "bun scripts/test-unit.ts",
    "test:telemetry:local": "node scripts/verify-telemetry-local.mjs",
    "test:performance": "playwright test e2e/topic-performance.spec.ts --workers=1 --reporter=line",
    "test:network": "playwright test e2e/network- --workers=1 --reporter=line",
    "test:users:performance": "playwright test e2e/user-directory-performance.spec.ts --workers=1 --reporter=line",
    "test:pdf-worker": "node --experimental-strip-types scripts/verify-pdf-worker.ts",
    "test:notifications:performance": "playwright test e2e/notification-performance.spec.ts --workers=1 --reporter=line",
    "test:android:performance": "node --experimental-strip-types scripts/verify-android-performance.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:desktop:native": "bun scripts/test-desktop-native-smoke.ts",
    "verify:approval": "bun scripts/verify-mastra-approval.ts",
    "format": "prettier -w {src,scripts}/**/*.ts -w {src,scripts}/**/*.vue",
    "prepare": "echo 'Running preinstall script' && lefthook install",
    "start:ios": "bun run sync && npx cap open ios",
    "start:android": "bun run sync:android && npx cap open android",
    "start:tauri": "bun run tauri:dev",
    "sync": "bun vite build && npx cap sync",
    "build:android": "cross-env VITE_EMOJI_ASSET_BASE_URL=https://chat.pksep.ru/emoji/noto VITE_CALL_BACKGROUND_ASSET_BASE_URL=https://chat.pksep.ru/call-background VITE_REACTION_VIDEO_ASSET_BASE_URL=https://chat.pksep.ru/video vite build",
    "sync:android": "bun run build:android && npx cap sync android",
    "generate:assets": "npx capacitor-assets generate --ios",
    "generate:ios-splash": "bun scripts/generate-ios-splash.ts",
    "tauri": "tauri",
    "tauri:serve": "node ./scripts/ensure-tauri-dev-server.mjs",
    "tauri:dev": "bun scripts/dev-desktop.ts",
    "tauri:build": "bun scripts/build-desktop.ts"
  },
  "exports": {
    ".": {
      "import": "./build/lib/chat-container.js",
      "types": "./build/lib/chat-container.d.ts"
    }
  },
  "files": [
    "build/lib/*.js",
    "build/lib/*.ts"
  ],
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/barcode-scanner": "^3.0.0",
    "@capacitor/clipboard": "8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.5",
    "@fontsource-variable/inter": "^5.2.6",
    "@livekit/track-processors": "^0.7.2",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@mastra/client-js": "1.40.0",
    "@pksep/reqi": "0.0.25",
    "@pksep/yui": "0.1.353",
    "@pksep/zod-shared-chat": "0.0.6",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "dompurify": "^3.4.14",
    "fflate": "0.8.2",
    "highlight.js": "11",
    "livekit-client": "^2.15.7",
    "lottie-web": "5.13.0",
    "marked": "15.0.12",
    "pinia": "^4.0.3",
    "qrcode": "1.5.4",
    "socket.io-client": "^4.8.3",
    "zod": "3"
  },
  "peerDependencies": {
    "zod": "3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@capacitor/cli": "^8.0.1",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@playwright/experimental-ct-vue": "^1.56.1",
    "@playwright/test": "^1.56.1",
    "@rushstack/eslint-patch": "^1.12.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@tauri-apps/cli": "^2.12.0",
    "@types/eslint-scope": "3.7.7",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "babel-eslint": "^10.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-scope": "7.2.2",
    "lefthook": "^1.12.3",
    "postcss": "8.5.26",
    "prettier": "3.2.4",
    "sass-embedded": "^1.103.1",
    "semantic-release": "^25.0.2",
    "socket.io": "4.8.3",
    "typebox": "1.3.27",
    "typescript": "~5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-private-methods"
    ]
  },
  "packageManager": "bun@1.3.14"
}
