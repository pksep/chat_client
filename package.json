{
  "name": "@sep-chat-client/root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start:dev": "pnpm --filter './packages/*' run start:dev",
    "start": "pnpm  --filter './packages/*' run start",
    "build:lib": "pnpm  --filter './packages/chat-core' run build:lib",
    "build": "pnpm run lint && pnpm --filter './packages/*' run build",
    "lint": "eslint --fix --ext .js,.ts,.vue packages",
    "format": "prettier -w packages/**/*.ts -w packages/**/*.vue",
    "prepare": "echo 'Running preinstall script' && lefthook install"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@pksep/chat-core": "workspace:*",
    "@rushstack/eslint-patch": "^1.12.0",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "sep_yui": "link:../../local-packages/sep_yui",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.18",
    "vue-eslint-parser": "^9.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "babel-eslint": "^10.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "lefthook": "^1.12.3",
    "prettier": "3.2.4",
    "typescript": "~5.6.3",
    "vite": "^7.1.7",
    "vue-tsc": "^2.2.12"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-private-methods"
    ]
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
