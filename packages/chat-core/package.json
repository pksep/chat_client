{
  "name": "@pksep/chat-core",
  "version": "25.12.0",
  "type": "module",
  "main": "./build/chat-container.js",
  "types": "./build/chat-container.d.ts",
  "scripts": {
    "start:dev": "vite",
    "start": "vite preview",
    "build": "vue-tsc && vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:lib": "cross-env VITE_BASE_MODE=lib pnpm run build",
    "publish:lib": "pnpm run build:lib && pnpm publish --access public --no-git-checks",
    "generate:assets": "pwa-assets-generator",
    "init:openim": "node ./scripts/copyOpenIM.ts",
    "init:openim-admin": "tsx ./scripts/getAdminTokenOpenIM.ts"
  },
  "exports": {
    ".": {
      "import": "./build/chat-container.js",
      "types": "./build/chat-container.d.ts"
    }
  },
  "files": [
    "build/chat-container.js",
    "build/chat-container.d.ts",
    "build/copyOpenIM.ts"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@mastra/client-js": "^0.12.3",
    "@openim/wasm-client-sdk": "3.8.3-patch.10",
    "@pksep/reqi": "^0.0.21",
    "@pksep/yui": "0.1.143",
    "zod": "3"
  },
  "peerDependencies": {
    "@pksep/yui": "0.1.x",
    "zod": "3"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "^1.56.1",
    "@playwright/test": "^1.56.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "overrides": {
    "@pksep/yui": "$@pksep/yui"
  }
}
