{
  "name": "@pksep/chat-core",
  "version": "25.10.4",
  "type": "module",
  "main": "./build/chat-container.js",
  "types": "./build/chat-container.d.ts",
  "scripts": {
    "start:dev": "vite",
    "start": "vite preview",
    "build": "vue-tsc && vite build",
    "build:lib": "VITE_BASE_MODE=lib pnpm run build",
    "publish:lib": "pnpm run build:lib && pnpm publish --access public --no-git-checks",
    "copy:openim": "node --experimental-strip-types ./scripts/copyOpenIM.ts"
  },
  "exports": {
    ".": {
      "import": "./build/chat-container.js",
      "types": "./build/chat-container.d.ts"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@mastra/client-js": "^0.12.3",
    "@openim/wasm-client-sdk": "3.8.3-patch.10",
    "@pksep/reqi": "^0.0.21",
    "sep-yui": "0.1.122",
    "zod": "3"
  },
  "peerDependencies": {
    "zod": "3"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^1.0.2",
    "vite-plugin-pwa": "^1.1.0"
  }
}
