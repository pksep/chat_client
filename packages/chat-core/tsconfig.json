{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "vite-plugin-pwa/pwa-assets"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "./src/*.ts",
    "./src/*.js",
    "./src/**/*.ts",
    "./src/**/*.js",
    "./src/**/*.d.ts",
    "./src/**/*.vue",
    "./tests/**/*.ts",
    "./src/**/*.json"
  ]
}
