{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEP Chat",
  "version": "1.6.0",
  "identifier": "ru.pksep.chat",
  "build": {
    "beforeDevCommand": "bun run tauri:serve",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SEP Chat",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "../public/images/pwa-64x64.png",
      "../public/images/pwa-192x192.png",
      "../public/images/pwa-512x512.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFNFUCBDaGF0IHVwZGF0ZXIgcHVibGljIGtleQpSV1JvSkJKRFp5L3R1cGdqWFU0TTc3NFVGM3krSWFUV1poUGNwQmEwWHNjQWs2S0RWb1I4eFphNwo=",
      "endpoints": ["https://chat.pksep.ru/desktop/stable/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
