{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "СЭП Чат",
  "version": "1.6.0",
  "identifier": "ru.pksep.chat",
  "build": {
    "beforeDevCommand": "bun run tauri:serve",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "СЭП Чат",
        "decorations": false,
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "linux": {
      "appimage": { "bundleMediaFramework": true }
    },
    "macOS": {
      "bundleName": "SEP Chat",
      "minimumSystemVersion": "12.3",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "language": "ru-RU",
        "upgradeCode": "6e8ba11b-f460-543e-874f-1c95c1aa6705"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/brand-migration.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["sepchat"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFNFUCBDaGF0IHVwZGF0ZXIgcHVibGljIGtleQpSV1JvSkJKRFp5L3R1cGdqWFU0TTc3NFVGM3krSWFUV1poUGNwQmEwWHNjQWs2S0RWb1I4eFphNwo=",
      "endpoints": [
        "https://github.com/pksep/chat_client/releases/download/desktop-stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
